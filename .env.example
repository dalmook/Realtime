# Company runtime only. Do not commit .env. No interpolation of $ or backslashes.
DATA_DIR=
DASH_HOST=127.0.0.1
DASH_PORT=8765
OPEN_BROWSER=true
SPLUNK_ENABLED=true
SPLUNK_HOST=
SPLUNK_PORT=8089
SPLUNK_USER=
SPLUNK_PASSWORD=
# TLS disabled only for an IT-approved internal self-signed endpoint.
SPLUNK_VERIFY_SSL=false
SPLUNK_CA_BUNDLE=
SPLUNK_PROXY=
SPLUNK_TIMEOUT=180
SPLUNK_SETTLE_SECONDS=10
ORACLE_ENABLED=true
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_CLIENT_LIB_DIR=C:\instantclient
ORACLE_TIMEOUT_MS=30000
AUTO_BACKUP=true
BACKUP_KEEP=7
RAW_RETENTION_DAYS=30
# Count semantics of CARTON must be confirmed against SAP before live BOX reporting.
SHIPMENT_BOX_CONFIRMED=false
# Optional: allow an approved UI origin when serving UI separately. Blank=same origin only.
DASH_ALLOWED_ORIGIN=
